# --- обов'язкові ---
# на Neon: рядок підключення з ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amina
JWT_SECRET=change-me-to-a-long-random-string
# перший адміністратор створюється автоматично при старті
ADMIN_EMAIL=admin@amina.store
ADMIN_PASSWORD=change-me
# на Render: https://amina.onrender.com (або власний домен)
PUBLIC_URL=http://localhost:3000
# демо-категорії й товари, якщо каталог порожній
SEED_DEMO=true

# --- email (одне з двох) ---
MAIL_FROM="Amina <orders@your-domain.com>"
# resend.com — працює на безкоштовному Render (SMTP там заблоковано)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Telegram (сповіщення адміну + клієнту) ---
# від @BotFather
TELEGRAM_BOT_TOKEN=
# напр. amina_store_bot
TELEGRAM_BOT_USERNAME=
# будь-який випадковий рядок
TELEGRAM_WEBHOOK_SECRET=

# --- Viber ---
VIBER_BOT_TOKEN=
# URI бота з партнерського кабінету Viber
VIBER_BOT_URI=

# --- WhatsApp Cloud API (опційно, потрібен затверджений шаблон) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# шаблон з 4 параметрами: ім'я, номер замовлення, статус, деталі
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=uk

# --- оплата / доставка ---
# токен еквайрингу monobank (оплата карткою онлайн)
MONOBANK_TOKEN=
# автопідказки міст і відділень
NOVA_POSHTA_API_KEY=

# --- чат-бот ---
# без ключа бот працює у простому режимі (FAQ + пошук)
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-opus-5-5
